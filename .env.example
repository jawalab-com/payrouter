# ==============================================================================
# STRIPE COMPATIBLE FACADE & ORCHESTRATOR CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual merchant gateway credentials.
# Public base rates are defined in config.yaml; use variables below for overrides.
# ==============================================================================

# Server Listen Address & Security Bearer API Key
PAYMENT_ADDR=:8787
PAYMENT_API_KEY=sk_test_payment_secret_key
PAYMENT_CONFIG_PATH=./config.yaml
PAYMENT_GATEWAY=auto # Options: auto (dynamic least-cost), midtrans, xendit, doku, mayar, stub

# development | production. In production, PAYMENT_DATABASE_URL and an explicit
# WEBHOOK_SIGNING_SECRET are mandatory and startup fails without them.
PAYMENT_APP_ENV=development

# Per-request body ceiling in bytes (default 1 MiB). Oversized requests are
# rejected with HTTP 413 before any handler reads them.
PAYMENT_MAX_BODY_BYTES=1048576

# Per-caller rate limit (API key when presented, client IP otherwise). Counted
# per instance, so N replicas allow N times this. Set RPS=0 to disable when an
# upstream load balancer already enforces quotas.
PAYMENT_RATE_LIMIT_RPS=50
PAYMENT_RATE_LIMIT_BURST=100

# Browser origins allowed to call the API, comma-separated. Empty (default)
# disables CORS entirely. Only exact origins are honored — never a wildcard.
# The v1 API authenticates with secret sk_ keys, which do not belong in browser
# code; set this only for origins that use client-secret-scoped endpoints.
# PAYMENT_CORS_ORIGINS=https://shop.example.com

# Honor X-Forwarded-For / X-Real-Ip for client IP. Enable ONLY when PayRouter
# sits behind a proxy you control — otherwise any caller can spoof these headers
# and pick their own rate-limit bucket.
PAYMENT_TRUST_PROXY_HEADERS=false

# Outbound Stripe Webhook Forwarding to your Application
PAYMENT_WEBHOOK_URL=https://your-app.example.com/api/stripe-webhook
WEBHOOK_SIGNING_SECRET=whsec_your_stripe_compatible_signing_secret

# Durable Persistence (PostgreSQL).
# REQUIRED in production: without it, Idempotency-Key is ignored and inbound
# webhooks are not deduplicated, so retries can create duplicate payments.
# Memory mode (leaving this unset) is for development and evaluation only.
# PAYMENT_DATABASE_URL=postgres://user:password@localhost:5432/payment?sslmode=disable

# ------------------------------------------------------------------------------
# GATEWAY MERCHANT CREDENTIALS (BYO - Bring Your Own Keys)
# ------------------------------------------------------------------------------

# Midtrans Credentials
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_SANDBOX=true

# Xendit Credentials
XENDIT_SECRET_KEY=xnd_development_YOUR_SECRET_KEY
XENDIT_WEBHOOK_TOKEN=YOUR_XENDIT_CALLBACK_TOKEN

# DOKU Credentials
DOKU_CLIENT_ID=MCH-YOUR_CLIENT_ID
DOKU_SECRET_KEY=SK-YOUR_SECRET_KEY
DOKU_SANDBOX=true

# Mayar Credentials
MAYAR_API_KEY=mayar_sec_YOUR_API_KEY
MAYAR_WEBHOOK_TOKEN=YOUR_MAYAR_WEBHOOK_TOKEN
MAYAR_SANDBOX=true

# ------------------------------------------------------------------------------
# OPTIONAL: NEGOTIATED ENTERPRISE RATE OVERRIDES
# ------------------------------------------------------------------------------
# These variables override the default fee schedule in config.yaml.
# Leave commented out to use the public standard rates in config.yaml.
# Format: <GATEWAY>_FEE_<CHANNEL>_<FIXED|PCT>
# ------------------------------------------------------------------------------

# VAT / PPN Rate Override (Default: 0.11 for 11% Indonesian PPN)
# VAT_RATE=0.11

# Midtrans Rate Overrides (Overrides values in config.yaml under providers.midtrans)
# MIDTRANS_FEE_VA_FIXED=3500
# MIDTRANS_FEE_QRIS_PCT=0.006
# MIDTRANS_FEE_CC_PCT=0.025
# MIDTRANS_FEE_CC_FIXED=2000

# Xendit Rate Overrides (Overrides values in config.yaml under providers.xendit)
# XENDIT_FEE_VA_FIXED=2500
# XENDIT_FEE_QRIS_PCT=0.0045
# XENDIT_FEE_CC_PCT=0.024
# XENDIT_FEE_RETAIL_FIXED=3500

# DOKU Rate Overrides (Overrides values in config.yaml under providers.doku)
# DOKU_FEE_VA_FIXED=3000
# DOKU_FEE_QRIS_PCT=0.005
# DOKU_FEE_CC_PCT=0.025

# Mayar Rate Overrides (Overrides values in config.yaml under providers.mayar)
# MAYAR_PLATFORM_FEE_PCT=0.01          # Override Mayar platform tier fee (e.g. 1.0% Business tier)
# MAYAR_FEE_VA_FIXED=3500
# MAYAR_FEE_CC_PCT=0.024
